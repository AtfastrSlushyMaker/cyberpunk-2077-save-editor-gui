diff --git a/WolvenKit.RED4/Types/Classes/gameBufferSlice.cs b/WolvenKit.RED4/Types/Classes/gameBufferSlice.cs
new file mode 100644
index 00000000..2ba17530
--- /dev/null
+++ b/WolvenKit.RED4/Types/Classes/gameBufferSlice.cs
@@ -0,0 +1,31 @@
+using static WolvenKit.RED4.Types.Enums;
+
+namespace WolvenKit.RED4.Types
+{
+	// Added in patch 2.5: a window into gameStatsStateMapStructure.sharedDataBuffer.
+	public partial class gameBufferSlice : RedBaseClass
+	{
+		[Ordinal(0)]
+		[RED("offset")]
+		public CUInt32 Offset
+		{
+			get => GetPropertyValue<CUInt32>();
+			set => SetPropertyValue<CUInt32>(value);
+		}
+
+		[Ordinal(1)]
+		[RED("combined")]
+		public CUInt32 Combined
+		{
+			get => GetPropertyValue<CUInt32>();
+			set => SetPropertyValue<CUInt32>(value);
