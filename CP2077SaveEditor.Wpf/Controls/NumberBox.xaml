<UserControl x:Class="CP2077SaveEditor.Wpf.Controls.NumberBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="34">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Padding="0" Click="Decrement_Click" ToolTip="Decrease (hold Shift for ×10)" IsTabStop="False">
            <TextBlock Text="&#xE738;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
        </Button>
        <TextBox x:Name="Input" Grid.Column="1" BorderThickness="0,1" TextAlignment="Center" VerticalContentAlignment="Center" Padding="2,0"
                 FontFamily="{StaticResource DisplayFont}" FontSize="15"
                 LostKeyboardFocus="Input_LostKeyboardFocus" KeyDown="Input_KeyDown" PreviewMouseWheel="Input_MouseWheel" />
        <Button Grid.Column="2" Padding="0" Click="Increment_Click" ToolTip="Increase (hold Shift for ×10)" IsTabStop="False">
            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
        </Button>
        <!-- fill bar: value relative to maximum -->
        <Rectangle x:Name="Fill" Grid.Column="1" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Fill="{StaticResource CyanBrush}" IsHitTestVisible="False" />
    </Grid>
</UserControl>
