<UserControl x:Class="CP2077SaveEditor.Wpf.Views.SaveBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CP2077SaveEditor.Wpf.ViewModels">
    <DockPanel Margin="28,24,12,0">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,16,18">
            <StackPanel>
                <TextBlock Text="SAVES" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Grid Width="220" Margin="0,0,8,0">
                    <TextBox x:Name="SearchBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,8,7" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource TextDimBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Search quest, slot, life path…" Foreground="{StaticResource TextDimBrush}" Margin="31,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Command="{Binding RefreshCommand}" ToolTip="Rescan saves" Margin="0,0,8,0" Padding="12,7">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button Command="{Binding OpenFolderCommand}" ToolTip="Open the game's saves folder" Margin="0,0,8,0" Padding="12,7">
                    <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button Content="ADD FOLDER" Command="{Binding AddFolderCommand}" Margin="0,0,8,0"
                        ToolTip="Also show the saves in another folder (e.g. a backup), without copying them" />
                <Button Content="IMPORT SAVE" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}"
                        ToolTip="Copy save folders from anywhere into your library (Documents\CP2077 Save Editor\Library)" />
            </StackPanel>
        </Grid>

        <!-- Sources -->
        <Grid DockPanel.Dock="Top" Margin="0,0,16,8">
            <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Style="{StaticResource ChipList}" />
            <Button Content="Stop showing this folder" Command="{Binding RemoveFolderCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,4"
                    Visibility="{Binding CanRemoveFolder, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}" Foreground="{StaticResource CyanBrush}" Margin="0,0,16,10" TextWrapping="Wrap"
                   Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />

        <!-- Gallery -->
        <ListBox x:Name="Gallery" ItemsSource="{Binding SlotsView}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Cycle"
                 MouseDoubleClick="Gallery_MouseDoubleClick" KeyDown="Gallery_KeyDown">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Margin="0,0,0,24" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,16,16" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Frame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource TextDimBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SaveSlotViewModel}">
                    <StackPanel Width="300">
                        <!-- Screenshot with badges -->
                        <Grid Height="169" Background="{StaticResource BgBrush}" ClipToBounds="True">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            <Border Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,3">
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource BgBrush}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#CC0B0B10" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Slot.IsSupported}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource RedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Patch, StringFormat=PATCH {0}}" FontFamily="{StaticResource DisplayFont}" FontSize="11" />
                            </Border>
                            <Border VerticalAlignment="Bottom" Padding="10,18,10,6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#000B0B10" Offset="0" />
                                        <GradientStop Color="#E60B0B10" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{StaticResource CyanBrush}" Padding="6,1"
                                            Visibility="{Binding Slot.IsGameSave, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="{Binding Slot.Source}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BgBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Slot.FolderName}" Style="{StaticResource Label}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </Grid>
                        <!-- Details -->
                        <StackPanel Margin="12,10,12,12">
                            <TextBlock Text="{Binding Quest}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Character}" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="12" Margin="0,4,0,0" />
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{Binding When}" Style="{StaticResource Dim}" />
                                <TextBlock Text="{Binding PlayTime}" Style="{StaticResource Dim}" HorizontalAlignment="Right" />
                            </Grid>
                            <!-- Actions -->
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Padding="8,4" ToolTip="Show in Explorer"
                                        Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="COPY TO LIBRARY" Padding="8,4" FontSize="11" Margin="0,0,6,0" ToolTip="Keep a copy of this save in your library"
                                            Visibility="{Binding Slot.IsGameSave, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.CopyToLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="COPY TO GAME" Padding="8,4" FontSize="11" Margin="0,0,6,0" ToolTip="Copy into the game's save folder so it shows in Load Game"
                                            Visibility="{Binding Slot.IsGameSave, Converter={StaticResource InverseBoolToVisibility}}"
                                            Command="{Binding DataContext.CopyToGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="MOVE TO GAME" Padding="8,4" FontSize="11" ToolTip="Move into the game's save folder"
                                            Visibility="{Binding Slot.IsGameSave, Converter={StaticResource InverseBoolToVisibility}}"
                                            Command="{Binding DataContext.MoveToGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
