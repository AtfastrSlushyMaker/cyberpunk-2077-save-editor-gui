<UserControl x:Class="CP2077SaveEditor.Wpf.Views.AppearanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CP2077SaveEditor.Wpf.ViewModels">
    <Grid Margin="28,24,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Text="APPEARANCE" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Notice}" Style="{StaticResource Dim}" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,0"
                       Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <!-- Body & voice -->
        <ContentControl Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="BODY &amp; VOICE" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,14" />
                <TextBlock Text="BODY TYPE" Style="{StaticResource Label}" Margin="0,0,0,6" />
                <UniformGrid Columns="2">
                    <Button Content="Masculine" Style="{StaticResource SegmentButton}" Command="{Binding SetBodyGenderCommand}" CommandParameter="Male" Tag="{Binding IsBodyMale}" />
                    <Button Content="Feminine" Style="{StaticResource SegmentButton}" Command="{Binding SetBodyGenderCommand}" CommandParameter="Female" Margin="0">
                        <Button.Tag>
                            <Binding Path="IsBodyMale" Converter="{StaticResource InverseBool}" />
                        </Button.Tag>
                    </Button>
                </UniformGrid>
                <TextBlock Text="VOICE TONE" Style="{StaticResource Label}" Margin="0,14,0,6" />
                <UniformGrid Columns="2">
                    <Button Content="Masculine" Style="{StaticResource SegmentButton}" Command="{Binding SetVoiceToneCommand}" CommandParameter="Male" Tag="{Binding IsVoiceMale}" />
                    <Button Content="Feminine" Style="{StaticResource SegmentButton}" Command="{Binding SetVoiceToneCommand}" CommandParameter="Female" Margin="0">
                        <Button.Tag>
                            <Binding Path="IsVoiceMale" Converter="{StaticResource InverseBool}" />
                        </Button.Tag>
                    </Button>
                </UniformGrid>
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"
                           Text="Changing the body type resets the face and body to the default preset. Changing voice tone can affect romances and some scenes." />
            </StackPanel>
        </ContentControl>

        <!-- Presets -->
        <ContentControl Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="PRESETS" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,14" />
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Save this character's look to a .v2preset file, or apply a preset from another save. Classic CyberCAT .preset files can be imported too." />
                <UniformGrid Columns="2">
                    <Button Content="Save preset…" Command="{Binding SavePresetCommand}" Margin="0,0,4,0" />
                    <Button Content="Load preset…" Command="{Binding LoadPresetCommand}" Margin="4,0,0,0" />
                </UniformGrid>
            </StackPanel>
        </ContentControl>

        <!-- Advanced -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ADVANCED · CUSTOMIZATION ENTRIES" Style="{StaticResource Label}" Margin="0,0,0,8" />
                <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Style="{StaticResource SearchBox}" Tag="Filter entries, e.g. hair or eyes…" />
                <ListBox ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedEntry}" DisplayMemberPath="Key" Style="{StaticResource RowList}" />
            </DockPanel>
            <ContentControl Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <Grid>
                    <TextBlock Text="Select an entry to edit its raw values. For experienced users." Style="{StaticResource Dim}" TextWrapping="Wrap"
                               Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisible}}" />
                    <StackPanel DataContext="{Binding SelectedEntry}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Key}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                        <TextBlock Text="DEFINITION" Style="{StaticResource Label}" Margin="0,14,0,4" />
                        <TextBox Text="{Binding Definition, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Text="NAME" Style="{StaticResource Label}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Text="RESOURCE PATH" Style="{StaticResource Label}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding ResourcePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="APPLY" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.ApplyEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,8,0" />
                            <Button Content="Revert" Command="{Binding DataContext.ResetEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
