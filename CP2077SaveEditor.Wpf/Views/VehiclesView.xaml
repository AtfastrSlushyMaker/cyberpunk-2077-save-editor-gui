<UserControl x:Class="CP2077SaveEditor.Wpf.Views.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CP2077SaveEditor.Wpf.ViewModels">
    <DockPanel Margin="28,24,20,20" MaxWidth="900" HorizontalAlignment="Left">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="VEHICLES" Style="{StaticResource H1}" />
            <TextBlock Text="Vehicles switched on here are in your garage and can be summoned in game." Style="{StaticResource Dim}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Notice}" Foreground="{StaticResource CyanBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Style="{StaticResource SearchBox}" Tag="Search vehicles…" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="UNLOCK ALL" Style="{StaticResource PrimaryButton}" Command="{Binding UnlockAllCommand}" />
            </StackPanel>
        </Grid>
        <ListBox ItemsSource="{Binding RowsView}" Style="{StaticResource RowList}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:VehicleRow}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Unlocked}" />
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                            <TextBlock Text="{Binding Record}" FontSize="10" Opacity="0.6" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
