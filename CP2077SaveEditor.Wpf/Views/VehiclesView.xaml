<UserControl x:Class="CP2077SaveEditor.Wpf.Views.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CP2077SaveEditor.Wpf.ViewModels">
    <UserControl.Resources>
        <!-- Favorite star: outline when off, solid yellow when on -->
        <Style x:Key="StarToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="Favorite (shown first in the call-vehicle menu)" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <TextBlock x:Name="Star" Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource TextDimBrush}" Background="Transparent" Padding="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Star" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                                <Setter TargetName="Star" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,24,20,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="VEHICLES" Style="{StaticResource H1}" />
            <TextBlock Text="Vehicles switched on are in your garage and can be called in game. Click a picture to enlarge it." Style="{StaticResource Dim}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Notice}" Foreground="{StaticResource CyanBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="300" Style="{StaticResource SearchBox}" Tag="Search name, brand or record…" />
                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Style="{StaticResource ChipList}" Margin="12,6,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="LOCK ALL" Command="{Binding LockAllCommand}" Margin="0,0,8,0" ToolTip="Lock every vehicle shown" />
                <Button Content="UNLOCK ALL" Style="{StaticResource PrimaryButton}" Command="{Binding UnlockAllCommand}" ToolTip="Unlock every vehicle shown" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RowsView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VehicleRow}">
                        <Border x:Name="Card" Width="268" Margin="0,0,12,12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <StackPanel>
                                <Button Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Cursor="Hand" ToolTip="Click to enlarge" Height="128" Background="#0FFFFFFF" BorderThickness="0" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Image Source="{Binding Icon}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="&#xE804;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36" Opacity="0.2"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}" />
                                        <Border Background="{StaticResource CyanBrush}" Padding="5,0" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Visibility="{Binding IsExpansion, Converter={StaticResource BoolToVisibility}}" ToolTip="Phantom Liberty vehicle">
                                            <TextBlock Text="PL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BgBrush}" />
                                        </Border>
                                    </Grid>
                                </Button>
                                <DockPanel Margin="12,10,10,12">
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Unlocked}" VerticalAlignment="Center" ToolTip="Unlocked (in your garage)" />
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource StarToggle}" IsChecked="{Binding Favorite}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
