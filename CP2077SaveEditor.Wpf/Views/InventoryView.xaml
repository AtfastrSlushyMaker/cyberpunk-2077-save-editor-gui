<UserControl x:Class="CP2077SaveEditor.Wpf.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CP2077SaveEditor.Wpf.ViewModels"
             xmlns:c="clr-namespace:CP2077SaveEditor.Wpf.Controls">
    <Grid Margin="28,24,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.ColumnSpan="5" Margin="0,0,0,16">
            <TextBlock Text="INVENTORY" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Containers -->
        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="CONTAINERS" Style="{StaticResource Label}" Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer}" DisplayMemberPath="Label" Style="{StaticResource RowList}" />
        </DockPanel>

        <!-- Items -->
        <DockPanel Grid.Row="1" Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,8,7" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource TextDimBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Search items…" Foreground="{StaticResource TextDimBrush}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="UPGRADE ALL ▾" Margin="0,0,8,0" Click="UpgradeMenu_Click" ToolTip="Set every item of a kind in this container to Tier 5++">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="All weapons → Tier 5++" Command="{Binding UpgradeAllCommand}" CommandParameter="Weapon" />
                                <MenuItem Header="All clothing → Tier 5++" Command="{Binding UpgradeAllCommand}" CommandParameter="Clothing" />
                                <MenuItem Header="All cyberware → Tier 5++" Command="{Binding UpgradeAllCommand}" CommandParameter="Cyberware" />
                                <MenuItem Header="Everything → Tier 5++" Command="{Binding UpgradeAllCommand}" CommandParameter="All" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="AddItemButton" Content="+ ADD ITEM" Style="{StaticResource PrimaryButton}" Command="{Binding AddItemCommand}" />
                </StackPanel>
            </Grid>
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Name"
                     Style="{StaticResource ChipList}" Margin="0,0,0,4" />

            <!-- column headers -->
            <Grid DockPanel.Dock="Top" Margin="11,0,11,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="NAME" Style="{StaticResource Label}" Margin="64,0,0,0" />
                <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="2" Text="TIER" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="3" Text="QTY" Style="{StaticResource Label}" HorizontalAlignment="Right" />
            </Grid>
            <ListBox x:Name="ItemList" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource RowList}" KeyDown="Items_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ItemRowViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="0,0,8,0">
                                <Border DockPanel.Dock="Left" Width="56" Height="32" Margin="0,0,8,0" Background="#14FFFFFF">
                                    <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" ToolTip="{Binding Name}" />
                                    <StackPanel Orientation="Horizontal" Margin="-6,2,0,0">
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsEquipped, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding EquippedIn}" FontSize="9" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource DisplayFont}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsQuestItem, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="QUEST" FontSize="9" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource DisplayFont}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Type}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding TierText}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding QuantityText}" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center"
                                       Visibility="{Binding HasQuantity, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Details -->
        <ContentControl Grid.Row="1" Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top">
            <Grid>
                <TextBlock Text="Select an item to edit it." Style="{StaticResource Dim}"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel DataContext="{Binding SelectedItem}" Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                    <Border Height="120" Margin="0,0,0,12" Background="#0FFFFFFF" Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}"
                            Cursor="Hand" ToolTip="Click to enlarge" MouseLeftButtonUp="Preview_Click">
                        <Image Source="{Binding Icon}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="17" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Record}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Style="{StaticResource Badge}" Margin="0">
                            <TextBlock Text="{Binding Type}" FontSize="11" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsEquipped, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding EquippedIn, StringFormat=Equipped · {0}}" FontSize="11" Foreground="{StaticResource CyanBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Quantity -->
                    <StackPanel Visibility="{Binding HasQuantity, Converter={StaticResource BoolToVisibility}}" Margin="0,18,0,0">
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}">
                                    <Binding Path="IsMoney" Converter="{StaticResource MoneyLabel}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <c:NumberBox Value="{Binding Quantity}" Minimum="1" Maximum="999999999" ShowFill="False" />
                    </StackPanel>

                    <!-- Tier -->
                    <StackPanel Visibility="{Binding HasTiers, Converter={StaticResource BoolToVisibility}}" Margin="0,18,0,0">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="TIER" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding TierText}" Style="{StaticResource Label}" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <UniformGrid Columns="5">
                            <Button Content="1" Style="{StaticResource SegmentButton}" Command="{Binding DataContext.SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="1" Tag="{Binding Tier, Converter={StaticResource TierMatch}, ConverterParameter=T1}" />
                            <Button Content="2" Style="{StaticResource SegmentButton}" Command="{Binding DataContext.SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="2" Tag="{Binding Tier, Converter={StaticResource TierMatch}, ConverterParameter=T2}" />
                            <Button Content="3" Style="{StaticResource SegmentButton}" Command="{Binding DataContext.SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="3" Tag="{Binding Tier, Converter={StaticResource TierMatch}, ConverterParameter=T3}" />
                            <Button Content="4" Style="{StaticResource SegmentButton}" Command="{Binding DataContext.SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="4" Tag="{Binding Tier, Converter={StaticResource TierMatch}, ConverterParameter=T4}" />
                            <Button Content="5" Style="{StaticResource SegmentButton}" Command="{Binding DataContext.SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="5" Tag="{Binding Tier, Converter={StaticResource TierMatch}, ConverterParameter=T5}" Margin="0" />
                        </UniformGrid>
                        <UniformGrid Columns="3" Margin="0,6,0,0">
                            <Button Content="—" Style="{StaticResource SegmentButton}" Command="{Binding DataContext.SetPlusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="0" Tag="{Binding Tier, Converter={StaticResource TierMatch}, ConverterParameter=P0}" />
                            <Button Content="+" Style="{StaticResource SegmentButton}" Command="{Binding DataContext.SetPlusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="1" Tag="{Binding Tier, Converter={StaticResource TierMatch}, ConverterParameter=P1}" />
                            <Button Content="++" Style="{StaticResource SegmentButton}" Command="{Binding DataContext.SetPlusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="2" Tag="{Binding Tier, Converter={StaticResource TierMatch}, ConverterParameter=P2}" Margin="0" ToolTip="Only exists at Tier 5" />
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                   Text="Tier 1 Common · 2 Uncommon · 3 Rare · 4 Epic · 5 Legendary. Setting a tier replaces the item's random quality roll." />
                    </StackPanel>

                    <CheckBox Content="Quest item (cannot be sold or dropped)" Style="{StaticResource Switch}" IsChecked="{Binding IsQuestItem}" Margin="0,18,0,0" />

                    <Button Content="REMOVE ITEM" Style="{StaticResource DangerButton}" Margin="0,20,0,0" HorizontalAlignment="Left"
                            Command="{Binding DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
