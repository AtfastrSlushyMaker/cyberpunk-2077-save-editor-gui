<Window x:Class="CP2077SaveEditor.Wpf.Views.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CP2077SaveEditor.Wpf.Controls"
        xmlns:vm="clr-namespace:CP2077SaveEditor.Wpf.ViewModels"
        Title="Add item" Width="720" Height="620" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Foreground="{StaticResource TextBrush}">

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <DockPanel Margin="24,20,24,20">
            <TextBlock DockPanel.Dock="Top" Text="ADD ITEM" Style="{StaticResource H1}" FontSize="22" MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsStackable, Converter={StaticResource BoolToVisibility}}" Margin="0,0,16,0">
                        <TextBlock Text="QUANTITY" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <c:NumberBox Value="{Binding Quantity}" Minimum="1" Maximum="999999" ShowFill="False" Width="150" />
                    </StackPanel>
                    <CheckBox Content="Set to Tier 5++" Style="{StaticResource Switch}" IsChecked="{Binding SetMaxTier}"
                              Visibility="{Binding CanHaveTier, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="ADD" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="{Binding CanAdd}" Click="Add_Click" MinWidth="110" />
                </StackPanel>
            </Grid>

            <!-- Search + filters -->
            <Grid DockPanel.Dock="Top" Margin="0,14,0,10">
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="30,7,8,7" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource TextDimBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock Text="Search 10,000+ items, e.g. &quot;mantis blades&quot; or &quot;Items.Preset_Overture&quot;…" Foreground="{StaticResource TextDimBrush}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Name"
                     Style="{StaticResource ChipList}" Margin="0,0,0,4" />

            <ListBox ItemsSource="{Binding CatalogView}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource RowList}" MouseDoubleClick="List_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AddItemRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="32" Background="#14FFFFFF" HorizontalAlignment="Left">
                                <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Record}" FontSize="10" Opacity="0.6" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Type}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
