<UserControl x:Class="CP2077SaveEditor.Wpf.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CP2077SaveEditor.Wpf.ViewModels"
             xmlns:c="clr-namespace:CP2077SaveEditor.Wpf.Controls">
    <UserControl.Resources>
        <!-- label + stepper -->
        <DataTemplate x:Key="StatRow" DataType="{x:Type vm:StatRowViewModel}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontSize="14" />
                    <TextBlock Text="{Binding Hint}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <c:NumberBox Grid.Column="1" Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- life path tile: image + name bar; selected = yellow bar with dark text -->
        <Style x:Key="LifePathItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
                            <StackPanel Width="96">
                                <Image Source="{Binding Image}" Height="120" Stretch="UniformToFill" />
                                <Border x:Name="Bar" Background="{StaticResource PanelRaisedBrush}" Padding="0,5">
                                    <TextBlock x:Name="Name" Text="{Binding Name}" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                                               Foreground="{StaticResource TextBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource TextDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Name" Property="Foreground" Value="{StaticResource BgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,20,24">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="PLAYER" Style="{StaticResource H1}" />
            <TextBlock Text="Changes apply to the open save right away. Nothing is written to disk until you use Save changes."
                       Style="{StaticResource Dim}" Margin="0,4,0,18" />

            <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                <ContentControl.Visibility>
                    <Binding Path="Error" Converter="{StaticResource NullToCollapsed}" />
                </ContentControl.Visibility>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource RedBrush}" TextWrapping="Wrap" />
            </ContentControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Character -->
                <ContentControl Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CHARACTER" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="LIFE PATH" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding LifePaths}" SelectedItem="{Binding SelectedLifePath}" ItemContainerStyle="{StaticResource LifePathItem}"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,0,16">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <ItemsControl ItemsSource="{Binding Character}" ItemTemplate="{StaticResource StatRow}" />
                    </StackPanel>
                </ContentControl>

                <!-- Presets -->
                <ContentControl Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="QUICK PRESETS" Style="{StaticResource CardTitle}" />
                        <Button Content="MAX EVERYTHING" Style="{StaticResource PrimaryButton}" Command="{Binding MaxEverythingCommand}" HorizontalAlignment="Stretch"
                                ToolTip="Level 60, Street Cred 50, every attribute 20 and every skill 60" />
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Content="Max level &amp; Street Cred" Command="{Binding MaxLevelCommand}" Margin="0,0,4,8" />
                            <Button Content="Max attributes" Command="{Binding MaxAttributesCommand}" Margin="4,0,0,8" />
                            <Button Content="Max skills" Command="{Binding MaxSkillsCommand}" Margin="0,0,4,8" />
                            <Button Content="Refund attributes" Command="{Binding RefundAttributesCommand}" Margin="4,0,0,8"
                                    ToolTip="Puts every attribute back to 3 and returns the points as unspent attribute points" />
                            <Button Content="+ 100,000 €$" Command="{Binding AddMoneyCommand}" CommandParameter="100000" Margin="0,0,4,0" />
                            <Button Content="+ 1,000,000 €$" Command="{Binding AddMoneyCommand}" CommandParameter="1000000" Margin="4,0,0,0" />
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Text="Tip: values above the game's limits are not allowed. Perks can be re-assigned in game with the perk points you add here." />
                    </StackPanel>
                </ContentControl>

                <!-- Attributes -->
                <ContentControl Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ATTRIBUTES" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Attributes}" ItemTemplate="{StaticResource StatRow}" />
                    </StackPanel>
                </ContentControl>

                <!-- Skills, points, money -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SKILLS" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Skills}" ItemTemplate="{StaticResource StatRow}" />
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="POINTS &amp; MONEY" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Points}" ItemTemplate="{StaticResource StatRow}" />
                            <ContentControl Content="{Binding Money}" ContentTemplate="{StaticResource StatRow}" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
