<Window x:Class="CP2077SaveEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CP2077SaveEditor.Wpf.ViewModels"
        xmlns:services="clr-namespace:CP2077SaveEditor.Wpf.Services"
        Title="CP2077 Save Editor" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Foreground="{StaticResource TextBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Navigation rail entries -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Root" Height="46" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Margin="22,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar -->
            <Border Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Rectangle Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" CenterX="5" CenterY="5" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock Text="CP2077" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text=" // SAVE EDITOR" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{x:Static vm:MainViewModel.Version}" Style="{StaticResource Label}" Margin="10,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="Maximize">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Close">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation rail -->
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="16">
                        <TextBlock Text="OPEN SAVE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding SessionTitle}" Style="{StaticResource H2}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SessionDetails}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Unsaved changes" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="12" />
                        </StackPanel>
                        <Button Content="SAVE CHANGES" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                                ToolTip="Review changes, then save to a new slot or overwrite with a backup (Ctrl+S)" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" ItemContainerStyle="{StaticResource NavItem}" IsTextSearchEnabled="False"
                             Background="Transparent" BorderThickness="0" Margin="0,12,0,0" Foreground="{StaticResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <!-- Page -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

            <!-- Status bar -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" FontSize="11" />
                        <TextBlock Text="  ·  " Style="{StaticResource Dim}" FontSize="11" />
                        <TextBlock Text="{Binding Status, Source={x:Static services:GameDataService.Instance}}" Style="{StaticResource Dim}" FontSize="11" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Dim}" FontSize="11"
                               Text="Based on CyberCAT-SimpleGUI by Deweh  ·  WolvenKit by the WolvenKit team" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
