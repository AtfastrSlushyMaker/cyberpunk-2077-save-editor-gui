<Application x:Class="CP2077SaveEditor.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CP2077SaveEditor.Wpf.ViewModels"
             xmlns:views="clr-namespace:CP2077SaveEditor.Wpf.Views"
             xmlns:local="clr-namespace:CP2077SaveEditor.Wpf"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:TierMatchConverter x:Key="TierMatch" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:MoneyLabelConverter x:Key="MoneyLabel" />
            <local:NullToVisibleConverter x:Key="NullToVisible" />

            <!-- Page view models -> views -->
            <DataTemplate DataType="{x:Type vm:SaveBrowserViewModel}">
                <views:SaveBrowserView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
                <views:PlayerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppearanceViewModel}">
                <views:AppearanceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VehiclesViewModel}">
                <views:VehiclesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuestFactsViewModel}">
                <views:QuestFactsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExtrasViewModel}">
                <views:ExtrasView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InfoViewModel}">
                <views:InfoView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
